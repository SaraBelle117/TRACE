   "source": [
    "# It is assumed that the first frame of the video contains all worms, and that they are clearly seperated.\n",
    "class TracePipeline:\n",
    "\n",
    "    def __init__(self, input_video):\n",
    "        self.video_loader = VideoLoader(input_video)\n",
    "        self.total_frames = self.video_loader.get_total_frames()\n",
    "        self.background = find_background(self.video_loader, n=100, k=20)\n",
    "        self.worm_data = ()\n",
    "        self.worm_count = 0\n",
    "        self.data_frames = []\n",
    "\n",
    "    def run(self):\n",
    "        self.process_video()\n",
    "        self.export_results(\"output\")\n",
    "\n",
    "    def process_video(self):\n",
    "        if (self.background is None):\n",
    "            print(\"Error: Could not find background.\")\n",
    "            return\n",
    "\n",
    "        # Setup worm identification using the first frame to determine the number of worms and their initial positions\n",
    "        first_frame = self.video_loader.get_next_frame()\n",
    "        preprocessed_first_frame = preprocess_frame(first_frame, self.background)\n",
    "        num_worms, worm_components = analyze_frame(preprocessed_first_frame)\n",
    "        self.worm_data = tuple([worm_components[i]] for i in range(num_worms))\n",
    "        self.worm_count = num_worms\n",
    "\n",
    "        while True:\n",
    "            try:\n",
    "                # Get the next frame from the video\n",
    "                frame = self.video_loader.get_next_frame()\n",
    "\n",
    "                # Preprocess the frame\n",
    "                preprocessed_frame = preprocess_frame(frame, self.background)\n",
    "\n",
    "                # Analyze a single frame\n",
    "                analysis_result = analyze_frame(preprocessed_frame)\n",
    "\n",
    "                # Identify Worms and add the data to the correct worm_data list\n",
    "                identify_worms(self.worm_data, analysis_result)\n",
    "            except StopIteration:\n",
    "                break\n",
    "        # Now, self.worm_data contains the time series data for each worm across all frames, so we can calculate the delta values for each worm.\n",
    "        delta_calculation(self.worm_count, self.worm_data)\n",
    "\n",
    "\n",
    "        # TODO: Calculate displacement of geodesic midpoint between frames, and the derivative of midbody curvature\n",
    "\n",
    "        # TODO: Calculate thrashing frequency from curvature and covariance seperately\n",
    "\n",
    "        # TODO: Classify the state of each worm based on the thrashing frequency and other features\n",
    "\n",
    "\n",
    "        # Build the results dataframe for each worm\n",
    "        for i in range(self.worm_count):\n",
    "            worm_time_series = self.worm_data[i]\n",
    "            self.data_frames.append(pd.DataFrame(worm_time_series))\n",
    "\n",
    "    def export_results(self, output_dir):\n",
    "        os.makedirs(output_dir, exist_ok=True)\n",
    "\n",
    "        for i, df in enumerate(self.data_frames):\n",
    "            output_file = os.path.join(output_dir, f\"worm_{i}.csv\")\n",
    "            df.to_csv(output_file, index=False)\n",
    "\n",
    "    def test_preprocessing(self):\n",
    "        # Test the preprocessing on the first frame\n",
    "        frame = self.video_loader.get_next_frame()\n",
    "        preprocessed_frame = preprocess_frame(frame, self.background)\n",
    "        plot_frames([frame, preprocessed_frame])\n",
    "\n",
    "    def test_single_frame_analysis(self):\n",
    "        # Test the single frame analysis on the first frame\n",
    "\n",
    "        frame = self.video_loader.get_next_frame()\n",
    "        preprocessed_frame = preprocess_frame(frame, self.background)\n",
    "        n, components = analyze_frame(preprocessed_frame)\n",
    "\n",
    "        frames = [frame, preprocessed_frame]\n",
    "        for i in range(n):\n",
    "            frames.append(components[i]['mask'])\n",
    "\n",
    "        plot_frames(frames)\n",
    "        print(f\"# of components found: {n}\\n{components}\")\n"
   ]
  },
