    "def worm_midbody(mask, pixel_size=1.0, smoothing=None, window=(0.4, 0.6)):\n",
    "    \"\"\"\n",
    "    Geodesic midpoint and midbody curvature for a mask containing ONE worm.\n",
    "    Returns a dict: length, midpoint_xy, midbody_curvature,\n",
    "    midbody_curvature_window_mean, dimensionless_curvature, centerline_xy.\n",
    "    \"\"\"\n",
    "    # --- 1. Crop to the worm's bounding box and skeletonize ----------------------\n",
    "    binary = mask > 0\n",
    "    x0, y0, w, h = cv2.boundingRect(binary.view(np.uint8))\n",
    "    pad = 2\n",
    "    crop = np.pad(binary[y0:y0 + h, x0:x0 + w], pad)\n",
    "    skeleton = skeletonize(crop)\n",
    "    coords = np.argwhere(skeleton)                              # (row, col) per pixel\n",
    "\n",
    "    # --- 2. Graph of 8-connected skeleton pixels (fully vectorised) -------------\n",
    "    pixel_id = np.full(skeleton.shape, -1, dtype=np.int32)\n",
    "    pixel_id[skeleton] = np.arange(len(coords), dtype=np.int32)\n",
    "    padded_id = np.pad(pixel_id, 1, constant_values=-1)         # no bounds checks needed\n",
    "    rows, cols = coords[:, 0] + 1, coords[:, 1] + 1\n",
    "    src, dst, dist = [], [], []\n",
    "    for dr, dc in [(0, 1), (1, 0), (1, 1), (1, -1)]:            # each pair counted once\n",
    "        neighbour = padded_id[rows + dr, cols + dc]\n",
    "        linked = neighbour >= 0\n",
    "        src.append(np.flatnonzero(linked)); dst.append(neighbour[linked])\n",
    "        dist.append(np.full(linked.sum(), np.hypot(dr, dc)))\n",
    "    n = len(coords)\n",
    "    graph = coo_matrix((np.concatenate(dist), (np.concatenate(src), np.concatenate(dst))),\n",
    "                       shape=(n, n)).tocsr()\n",
    "    graph = graph + graph.T\n",
    "\n",
    "    # --- 3. Longest geodesic path = head-to-tail centerline (double sweep) ------\n",
    "    end_a = int(np.argmax(np.where(np.isinf(d := dijkstra(graph, indices=0)), -1, d)))\n",
    "    d, parent = dijkstra(graph, indices=end_a, return_predecessors=True)\n",
    "    end_b = int(np.argmax(np.where(np.isinf(d), -1, d)))\n",
    "    path = [end_b]\n",
    "    while path[-1] != end_a:\n",
    "        path.append(parent[path[-1]])\n",
    "    centerline = coords[path[::-1]][:, ::-1] + [x0 - pad, y0 - pad]    # (x, y), full image\n",
    "\n",
    "    # --- 4. Smooth spline, parametrised by arc length ---------------------------\n",
    "    s = len(centerline) * 1.0 if smoothing is None else smoothing\n",
    "    spline, _ = splprep(centerline.T.astype(float), s=s, k=3)\n",
    "    u = np.linspace(0, 1, 500)\n",
    "    x, y = splev(u, spline)\n",
    "    arc = np.r_[0, np.cumsum(np.hypot(np.diff(x), np.diff(y)))]\n",
    "    length = arc[-1]\n",
    "\n",
    "    # --- 5. Midpoint and curvature  k = (x'y'' - y'x'') / (x'^2 + y'^2)^1.5 -----\n",
    "    u_mid = np.interp(length / 2, arc, u)\n",
    "    u_win = np.interp(np.linspace(window[0] * length, window[1] * length, 50), arc, u)\n",
    "    u_eval = np.r_[u_mid, u_win]\n",
    "    dx, dy = splev(u_eval, spline, der=1)\n",
    "    ddx, ddy = splev(u_eval, spline, der=2)\n",
    "    curvature = (dx * ddy - dy * ddx) / (dx**2 + dy**2) ** 1.5\n",
    "    x_mid, y_mid = splev(u_mid, spline)\n",
    "\n",
    "    return dict(\n",
    "        length=length * pixel_size,\n",
    "        midpoint_xy=(float(x_mid), float(y_mid)),\n",
    "        midbody_curvature=curvature[0] / pixel_size,\n",
    "        midbody_curvature_window_mean=curvature[1:].mean() / pixel_size,\n",
    "        dimensionless_curvature=curvature[0] * length,\n",
    "        centerline_xy=np.column_stack((x, y)),\n",
    "    )"
   ]
  },
