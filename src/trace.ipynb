    " \n",
    "    centered = np.zeros((size, size), dtype=np.uint8)\n",
    "    if src_x1 > src_x0 and src_y1 > src_y0:\n",
    "        centered[src_y0 + shift_y:src_y1 + shift_y,\n",
    "                 src_x0 + shift_x:src_x1 + shift_x] = \\\n",
    "            binary[src_y0:src_y1, src_x0:src_x1] * 255\n",
    " \n",
    "    lost = int(binary.sum() - (centered > 0).sum())\n",
    "    info = dict(midpoint_xy=(mid_x, mid_y), shift_xy=(shift_x, shift_y),\n",
    "                clipped=lost > 0, pixels_lost=lost)\n",
    "    return centered, info\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "fe9bb492",
   "metadata": {},
   "outputs": [],
   "source": [
    "def analyze_frame(mask: np.ndarray) -> Tuple[int, List[Dict]]:\n",
    "    num_components, labels, stats, centroids = cv2.connectedComponentsWithStats(mask, connectivity=8)\n",
    "\n",
    "    components = []\n",
    "    for i in range(1, num_components):  # Skip the background (label 0)\n",
    "        # Morphology stats that we care about\n",
    "\n",
    "        component_mask = (labels == i).astype(np.uint8) * 255\n",
    "        component_midbody_info = worm_midbody(component_mask)\n",
    "\n",
    "        components.append({\n",
    "            \"mask\": component_mask,\n",
    "            \"area\": stats[i, cv2.CC_STAT_AREA],\n",
    "            \"delta_area\": 0,  # Placeholder for area change calculation\n",
    "            \"midpoint_x\": component_midbody_info[\"midpoint_xy\"][0],\n",
    "            \"midpoint_y\": component_midbody_info[\"midpoint_xy\"][1],\n",
    "            \"delta_midpoint_x\": 0,  # Placeholder for displacement calculation\n",
    "            \"delta_midpoint_y\": 0,  # Placeholder for displacement calculation\n",
    "            \"length\": component_midbody_info[\"length\"],\n",
    "            \"delta_length\": 0,  # Placeholder for length change calculation\n",
    "            \"midbody_curvature\": component_midbody_info[\"midbody_curvature_window_mean\"],\n",
    "            \"delta_midbody_curvature\": 0,  # Placeholder for curvature change calculation\n",
    "            \"centroid\": centroids[i],\n",
    "            \"bounding_x\": stats[i, cv2.CC_STAT_LEFT],\n",
    "            \"bounding_y\": stats[i, cv2.CC_STAT_TOP],\n",
    "            \"bounding_w\": stats[i, cv2.CC_STAT_WIDTH],\n",
    "            \"bounding_h\": stats[i, cv2.CC_STAT_HEIGHT]\n",
    "        })\n",
    "    return num_components-1, components"
   ]
  },
