   "metadata": {},
   "outputs": [],
   "source": [
    "def preprocess_frame(frame: np.ndarray, background: np.ndarray) -> np.ndarray:\n",
    "    dark_difference = cv2.subtract(background, frame)\n",
    "    dark_difference = cv2.medianBlur(dark_difference, 3)\n",
    "    otsu_threshold, _ = cv2.threshold(dark_difference, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)\n",
    "    threshold = min(otsu_threshold, 12)\n",
    "    _, mask = cv2.threshold(dark_difference, threshold, 255, cv2.THRESH_BINARY)\n",
    "    _, labels, stats, _ = cv2.connectedComponentsWithStats(mask, connectivity=8)\n",
    "    keep_labels = np.flatnonzero(stats[1:, cv2.CC_STAT_AREA] >= 12) + 1\n",
    "    mask = np.where(np.isin(labels, keep_labels), 255, 0).astype(np.uint8)\n",
    "    return mask"
   ]
  },
