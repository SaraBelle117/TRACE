    "def find_background(video, n, k):\n",
    "    \"\"\"\n",
    "    >> CONTAINS CONTAINS GENERATED CODE <<\n",
    "\n",
    "    Estimate the background of a video using n sampled frames,\n",
    "    taking every k-th frame.\n",
    "\n",
    "    Parameters:\n",
    "        video: VideoLoader\n",
    "        n: Number of frames to sample\n",
    "        k: Number of frames to skip between samples\n",
    "\n",
    "    Returns:\n",
    "        A grayscale NumPy array representing the estimated background.\n",
    "    \"\"\"\n",
    "    video.reset()\n",
    "    frames = []\n",
    "\n",
    "    for _ in range(n):\n",
    "        # Get the next frame\n",
    "        frame = video.get_next_frame()\n",
    "\n",
    "        if frame is None:\n",
    "            break\n",
    "\n",
    "        frames.append(frame)\n",
    "\n",
    "        # Skip k frames\n",
    "        for _ in range(k):\n",
    "            if video.get_next_frame() is None:\n",
    "                break\n",
    "\n",
    "    if not frames:\n",
    "        return None\n",
    "\n",
    "    # Stack frames and calculate median for every pixel\n",
    "    frames = np.stack(frames, axis=0)\n",
    "\n",
    "    background = np.median(frames, axis=0).astype(np.uint8)\n",
    "    video.reset()\n",
    "    return background"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
