    "def plot_frames(l: List[np.ndarray], labels=None):\n",
    "    fig, axes = plt.subplots(1, len(l), figsize=(20, 10))\n",
    "\n",
    "    for i in range(len(l)):\n",
    "        axes[i].imshow(l[i], cmap='gray')\n",
    "        if labels is not None:\n",
    "            axes[i].set_title(labels[i])\n",
    "        axes[i].axis('off')  # Hide axis ticks\n",
    "        \n",
    "    # Adjust layout and show\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
