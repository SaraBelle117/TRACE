   "source": [
    "class VideoWriter:\n",
    "    \n",
    "    def __init__(self, output_video, fps, width, height):\n",
    "        self.output_video = output_video\n",
    "        self.fps = fps\n",
    "        self.width = width\n",
    "        self.height = height\n",
    "\n",
    "        self.container = av.open(output_video, mode='w')\n",
    "        self.stream = self.container.add_stream('avi', rate=fps)\n",
    "        self.stream.width = width\n",
    "        self.stream.height = height\n",
    "        self.stream.pix_fmt = 'gray' # Alternatively, 'gray' is grayscale, 'monow' is binary white, and 'monob' is binary black.\n",
    "\n",
    "    def write_frame(self, frame):\n",
    "        # Convert the frame to RGB format\n",
    "        rgb_frame = cv2.cvtColor(frame, cv2.COLOR_GRAY2RGB)\n",
    "\n",
    "        # Create an AVFrame from the RGB frame\n",
    "        av_frame = av.VideoFrame.from_ndarray(rgb_frame, format='rgb24')\n",
    "\n",
    "        # Encode the frame and write it to the container\n",
    "        for packet in self.stream.encode(av_frame):\n",
    "            self.container.mux(packet)\n",
    "\n",
    "    def close(self):\n",
    "        # Flush the encoder and write any remaining packets\n",
    "        for packet in self.stream.encode():\n",
    "            self.container.mux(packet)\n",
    "        \n",
    "        # Close the container\n",
    "        self.container.close()"
   ]
  },
