    "# I need to calculate the delta values for: area, midpoint_x, midpoint_y, length, midbody_curvature\n",
    "def delta_calculation(worm_count: int, worm_data: Tuple[List[Dict[str, any]]]):\n",
    "    for i in range(0, worm_count):\n",
    "        current_worm = worm_data[i]\n",
    "\n",
    "        # Skip delta calculations for the first row: they will be zero by default, since there is no previous frame to compare to.\n",
    "        for j in range(1, len(current_worm)):\n",
    "            current_worm_frame_data = current_worm[j]\n",
    "            previous_worm_frame_data = current_worm[j-1]\n",
    "\n",
    "            # Calculate delta values\n",
    "            current_worm[\"delta_area\"] = current_worm_frame_data[\"area\"] - previous_worm_frame_data[\"area\"]\n",
    "            current_worm[\"delta_midpoint_x\"] = current_worm_frame_data[\"midpoint_x\"] - previous_worm_frame_data[\"midpoint_x\"]\n",
    "            current_worm[\"delta_midpoint_y\"] = current_worm_frame_data[\"midpoint_y\"] - previous_worm_frame_data[\"midpoint_y\"]\n",
    "            current_worm[\"delta_length\"] = current_worm_frame_data[\"length\"] - previous_worm_frame_data[\"length\"]\n",
    "            current_worm[\"delta_midbody_curvature\"] = current_worm_frame_data[\"midbody_curvature\"] - previous_worm_frame_data[\"midbody_curvature\"]"
   ]
